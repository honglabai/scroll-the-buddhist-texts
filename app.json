{
  "expo": {
    "name": "마음스크롤 · Dharma Scroll",
    "slug": "scroll-the-buddhist-texts",
    "scheme": "dharmascroll",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.honglabai.dharmascroll"
    },
    "android": {
      "package": "com.honglabai.dharmascroll",
      "allowBackup": false,
      "adaptiveIcon": {
        "backgroundColor": "#F7F4EC",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-sharing"
    ]
  }
}
